set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(ARM_GNU_TOOLCHAIN_ROOT "$ENV{ARM_GNU_TOOLCHAIN_ROOT}" CACHE PATH "Arm GNU toolchain root")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES ARM_GNU_TOOLCHAIN_ROOT)
if(ARM_GNU_TOOLCHAIN_ROOT)
    set(_search HINTS "${ARM_GNU_TOOLCHAIN_ROOT}/bin" NO_DEFAULT_PATH)
endif()
find_program(CMAKE_C_COMPILER NAMES arm-none-eabi-gcc ${_search} REQUIRED)
find_program(CMAKE_ASM_COMPILER NAMES arm-none-eabi-gcc ${_search} REQUIRED)
find_program(CMAKE_AR NAMES arm-none-eabi-ar ${_search} REQUIRED)
find_program(CMAKE_RANLIB NAMES arm-none-eabi-ranlib ${_search} REQUIRED)
find_program(CMAKE_OBJCOPY NAMES arm-none-eabi-objcopy ${_search} REQUIRED)
find_program(CMAKE_SIZE NAMES arm-none-eabi-size ${_search} REQUIRED)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
